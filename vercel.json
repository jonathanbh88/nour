{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/catalogo/modelos/",
      "permanent": false
    },
    {
      "source": "/catalogo/",
      "has": [
        {
          "type": "query",
          "key": "loja",
          "value": "(?<loja>[a-z0-9-]+)"
        }
      ],
      "destination": "/loja/:loja/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/loja/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/catalogo/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/catalogo/painel/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/loja.js": {
      "includeFiles": "catalogo/{index.html,js/config.js}"
    },
    "api/sitemap.js": {
      "includeFiles": "catalogo/js/config.js"
    }
  },
  "rewrites": [
    {
      "source": "/loja/:slug/p/:p/",
      "destination": "/api/loja?slug=:slug&p=:p"
    },
    {
      "source": "/loja/:slug/p/:p",
      "destination": "/api/loja?slug=:slug&p=:p"
    },
    {
      "source": "/loja/:slug/",
      "destination": "/api/loja?slug=:slug"
    },
    {
      "source": "/loja/:slug",
      "destination": "/api/loja?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
