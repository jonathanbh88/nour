# Função catalogo-mp (Supabase Edge Function). Os valores reais ficam em
# Supabase → Edge Functions → Secrets, nunca neste repositório.
MP_APP_ID=            # Client ID da aplicação (também aceito como MP_CLIENT_ID)
MP_CLIENT_SECRET=     # Credenciais de produção → Client Secret
MP_WEBHOOK_SECRET=    # Webhooks → Assinatura secreta
MP_OAUTH_REDIRECT_URI=https://dvhinwfrofoxbtsnhxjc.supabase.co/functions/v1/catalogo-mp/retorno
MP_TOKEN_ENCRYPTION_KEY=   # opcional; sem ela a chave é derivada da chave de serviço do Supabase
MP_COMISSAO_PCT=0     # comissão da plataforma por venda, em %
CATALOGO_SITE=https://nour-catalogo.vercel.app
